MYSQL_ROOT_PASSWORD=YourRootPassword123!
MYSQL_DATABASE=gym_db
MYSQL_USER=gym_app_user
MYSQL_PASSWORD=YourAppPassword123!
MYSQL_PORT=3306

DB_HOST=gym-db
DB_PORT=3306
DB_NAME=gym_db
DB_USER=gym_app_user
DB_PASSWORD=YourAppPassword123!
AES_SECRET_KEY=YourSuperSecretKey2026!

EXPORTER_USER=mysqld_exporter
EXPORTER_PASSWORD=ExporterPassword123!

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminPassword123!
